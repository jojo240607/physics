+                if s.as_any().is::<RigidSubsystem<f64>>() {
+                    idx = Some(i);
+                    break;
+                }
+            }
+        }
+        idx.and_then(|i| self.get_mut(i).and_then(|s| s.as_any_mut().downcast_mut()))
